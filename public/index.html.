<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>Dmatx Dashboard</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--bg:#0b1220;--card:#111a2e;--bd:#22304d;--tx:#e6ecf7;--mut:#8a9bb8;--up:#22c55e;--dn:#ef4444;--ac:#2f9bff;--warn:#f5b301}
:root[data-theme=light]{--bg:#f4f6fb;--card:#fff;--bd:#d9e0ee;--tx:#111a2e;--mut:#5b6b88}
@media(prefers-color-scheme:light){:root:not([data-theme=dark]){--bg:#f4f6fb;--card:#fff;--bd:#d9e0ee;--tx:#111a2e;--mut:#5b6b88}}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:14px system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
header{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid var(--bd)}
h1{font-size:18px;margin:0}small,.mut{color:var(--mut)}
main{padding:14px 16px;max-width:1300px;margin:auto}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px;margin-bottom:14px}
.row{display:flex;flex-wrap:wrap;gap:10px;align-items:end}
label{display:flex;flex-direction:column;font-size:11px;color:var(--mut);gap:3px}
input,select,textarea{background:var(--bg);color:var(--tx);border:1px solid var(--bd);border-radius:8px;padding:7px 9px;font:inherit;width:100px}
textarea{width:100%;height:80px;font:12px monospace}
button{background:var(--ac);color:#fff;border:0;border-radius:8px;padding:8px 12px;font:inherit;cursor:pointer}
button.g{background:transparent;border:1px solid var(--bd);color:var(--tx)}
.tabs{display:flex;gap:6px;overflow-x:auto;margin-bottom:12px}.tabs button{white-space:nowrap}
.tabs button:not(.on){background:transparent;border:1px solid var(--bd);color:var(--mut)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}@media(max-width:800px){.grid{grid-template-columns:1fr}}
.tw{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:420px}
th,td{padding:7px 8px;text-align:right;border-bottom:1px solid var(--bd);white-space:nowrap}th:first-child,td:first-child,th:nth-child(2),td:nth-child(2){text-align:left}
th{font-size:11px;color:var(--mut);text-transform:uppercase}
.u{color:var(--up)}.d{color:var(--dn)}.pill{padding:2px 8px;border-radius:99px;background:var(--bd);font-size:12px}
.bar{height:6px;border-radius:4px;background:var(--bd);min-width:60px}.bar i{display:block;height:100%;border-radius:4px;background:var(--up)}
input[type=range]{width:100%;padding:0}
</style></head><body>
<header><div><h1>📊 Dmatx Dashboard <span class="pill">v2</span></h1><small id="stat">–</small></div>
<div class="row"><button class="g" id="th">Theme</button><button id="rf">Refresh Now</button></div></header>
<main>
<div class="card"><div class="row">
<label>Open=Low tolerance %<input id="tl" type="number" step="0.05" value="0.10"></label>
<label>Open=High tolerance %<input id="tH" type="number" step="0.05" value="0.10"></label>
<label>Volume spurt ≥ (x avg)<input id="vx" type="number" step="0.5" value="2"></label>
<label>Top N<input id="tn" type="number" value="10"></label>
<label>ORB range (min)<select id="orbm" style="width:90px"><option>5</option><option selected>15</option><option>30</option></select></label>
<label>Auto refresh (min)<select id="iv" style="width:110px"><option value="0">Off</option><option value="1">1</option><option value="5" selected>5</option></select></label>
<label>Data source<select id="src" style="width:130px"><option value="demo">Demo data</option><option value="paste">Pasted JSON</option><option value="api">Backend API (live)</option></select></label>
</div></div>
<div class="card"><b>Time snapshots (5-min)</b> <small id="dl"></small>
<div class="row" style="margin-top:8px"><label>Day<select id="day" style="width:130px"></select></label><div style="flex:1;min-width:200px"><input type="range" id="sl" min="0" max="0" value="0"></div><span id="sv" class="pill">LIVE</span><button class="g" id="live">Back to Live</button></div></div>
<div class="tabs" id="tabs"></div><div id="view"></div>
<div class="card"><b>Live data (Dhan / MCP)</b><p class="mut">Quotes ka JSON yahan paste karo (symbol-keyed format: <code>{"NSE:INFY":{"last_price":..,"volume":..,"ohlc":{"open","high","low","close"}}}</code>) ya page ke console/script se <code>dmatxLoad(json)</code> call karo.</p>
<textarea id="ta" placeholder="Paste quote JSON"></textarea><div class="row" style="margin-top:8px"><button id="ld">Load</button><button class="g" id="ex">Export saved data (JSON)</button></div></div>
</main>
<script>
const $=id=>document.getElementById(id),P='dmatx:';
const SYMS="RELIANCE TCS HDFCBANK INFY ICICIBANK SBIN AXISBANK ITC LT BHARTIARTL KOTAKBANK HCLTECH MARUTI SUNPHARMA TATAMOTORS TATASTEEL WIPRO ONGC NTPC POWERGRID ADANIENT HINDALCO YESBANK BANKINDIA NAMINDIA IDFCFIRSTB ANGELONE PNBHOUSING NATIONALUM ZYDUSLIFE BLUESTARCO DRREDDY BAJFINANCE TITAN COALINDIA JSWSTEEL VEDL DLF BEL HAL IRCTC".split(" ");
const S={rows:[],live:[],day:null,snap:null,tab:'gl',pasted:null};
const r2=x=>Math.round(x*100)/100,cl=(x,a,b)=>Math.max(a,Math.min(b,x));
const lsG=k=>{try{return JSON.parse(localStorage.getItem(P+k))}catch(e){return null}};
const lsS=(k,v)=>{try{localStorage.setItem(P+k,JSON.stringify(v));return true}catch(e){return false}};
const today=()=>new Date().toISOString().slice(0,10);
function demo(){return SYMS.map(s=>{const p=50+Math.random()*2950,o=p*(1+(Math.random()-.5)*.03),g=o*Math.random()*.02,r=Math.random();let h,l;
 if(r<.2){l=o;h=o+g}else if(r<.4){h=o;l=o-g}else{h=o+g*Math.random();l=o-g*Math.random()}
 const c=l+Math.random()*(h-l);return{symbol:s,d:1,prev:r2(p),open:r2(o),high:r2(h),low:r2(l),ltp:r2(c),vol:Math.round(1e5+Math.random()*6e6)}})}
function fromKite(q){return Object.entries(q).map(([k,v])=>({symbol:k.split(':').pop(),prev:v.ohlc.close,open:v.ohlc.open,high:v.ohlc.high,low:v.ohlc.low,ltp:v.last_price,vol:v.volume}))}
function avgVol(sym){const a=(lsG('vol')||{})[sym]||[];return a.length?a.reduce((x,y)=>x+y,0)/a.length:null}
function enrich(rows,day,slots){return rows.map(r=>{const a=avgVol(r.symbol)||r.vol*(0.6+Math.random()*.8);
 const chg=(r.ltp-r.prev)/r.prev*100,rng=r.high-r.low,tl=+$('tl').value,tH=+$('tH').value;
 const oLp=(r.open-r.low)/r.open*100,oHp=(r.high-r.open)/r.open*100;
 const e={...r,chg,volX:r.vol/a,oLp,oHp,pos:rng?(r.ltp-r.low)/rng:.5,isOL:oLp<=tl,isOH:oHp<=tH};
 let pers=0;if(slots&&slots.length){pers=slots.filter(s=>s.some(x=>x[0]===r.symbol&&x[1]>0)).length/slots.length}
 const why=[];let sc=cl(e.chg*8,0,30);if(e.chg>0)why.push('+'+e.chg.toFixed(2)+'% momentum');
 if(e.isOL&&e.ltp>e.open){sc+=20;why.push('Open=Low')}sc+=cl((e.volX-1)*10,0,20);if(e.volX>=+$('vx').value)why.push(e.volX.toFixed(1)+'x volume');
 sc+=e.pos*15;if(e.pos>.8)why.push('near day high');sc+=pers*15;if(pers>.6)why.push('holds gainers list');
 e.score=Math.round(cl(sc,0,100));e.why=why.join(' · ');return e})}
function saveSnap(rows){const d=today(),t=new Date(),m=String(Math.floor(t.getMinutes()/5)*5).padStart(2,'0'),k=String(t.getHours()).padStart(2,'0')+':'+m;
 const D=lsG('d:'+d)||{};D[k]=rows.map(r=>[r.symbol,r.chg?r2((r.ltp-r.prev)/r.prev*100):0,r.ltp,r.open,r.high,r.low,r.prev,r.vol]);
 if(!lsS('d:'+d,D))status('Storage full — export & clear old days');
 const V=lsG('vol')||{};rows.forEach(r=>{const a=V[r.symbol]||[];a[a.length-1&&a.d===d?a.length-1:a.length]=a.d===d?r.vol:r.vol});V.__d=V.__d||'';
 if(V.__d!==d){V.__d=d;rows.forEach(r=>{V[r.symbol]=(V[r.symbol]||[]);V[r.symbol].push(r.vol);if(V[r.symbol].length>20)V[r.symbol].shift()})}else rows.forEach(r=>{const a=V[r.symbol];if(a&&a.length)a[a.length-1]=r.vol});
 lsS('vol',V)}
function days(){try{return Object.keys(localStorage).filter(k=>k.startsWith(P+'d:')).map(k=>k.slice(P.length+2)).sort().reverse()}catch(e){return[]}}
function status(t){$('stat').textContent=t}
async function refresh(){let raw;
 if($('src').value==='api'){try{raw=fromKite(await(await fetch('/api/quotes')).json());const H=await(await fetch('/api/history')).json();for(const d in H)lsS('d:'+d,H[d])}catch(e){raw=demo()}}
 else if($('src').value==='paste'&&S.pasted)raw=S.pasted;else raw=demo();
 S.raw=raw;S.demo=!!(raw[0]&&raw[0].d);const D=lsG('d:'+today())||{};const slots=Object.values(D);
 S.live=enrich(raw,today(),slots);saveSnap(S.live);
 status((S.demo?'Demo (backend/paste not connected)':'Live')+' · updated '+new Date().toLocaleTimeString()+' · '+S.live.length+' stocks');
 loadDays(true);render()}
function loadDays(keep){const ds=days();if(!ds.includes(today()))ds.unshift(today());const sel=$('day'),cur=sel.value;sel.innerHTML=ds.map(d=>`<option>${d}</option>`).join('');
 if(keep&&ds.includes(cur))sel.value=cur;setSlider()}
function setSlider(){const D=lsG('d:'+$('day').value)||{},ks=Object.keys(D).sort(),sl=$('sl');sl.max=Math.max(0,ks.length-1);
 if(S.snap===null||S.snap==='live'){sl.value=sl.max;$('sv').textContent='LIVE'}$('dl').textContent=ks.length+' snapshots saved';S.ks=ks}
function current(){if(S.snap===null||S.snap==='live'){if($('day').value===today())return S.live}
 const D=lsG('d:'+$('day').value)||{},k=S.ks[$('sl').value];if(!D[k])return S.live;
 const rows=D[k].map(a=>({symbol:a[0],ltp:a[2],open:a[3],high:a[4],low:a[5],prev:a[6],vol:a[7]}));return enrich(rows,$('day').value,null)}
const f=(x,d=2)=>Number(x).toFixed(d),cc=x=>x>=0?'u':'d';
function tbl(rows,cols,ttl,badge){return`<div class="card"><b>${ttl}</b> <span class="pill">${badge??rows.length}</span><div class="tw"><table><tr><th>#</th>${cols.map(c=>`<th>${c[0]}</th>`).join('')}</tr>`+
 rows.map((r,i)=>`<tr><td>${i+1}</td>${cols.map(c=>`<td class="${c[2]?c[2](r):''}">${c[1](r)}</td>`).join('')}</tr>`).join('')+`</table></div></div>`}
const C={sym:['Symbol',r=>'<b>'+r.symbol+'</b>'],ltp:['Price ₹',r=>f(r.ltp)],chg:['Chg %',r=>(r.chg>=0?'+':'')+f(r.chg),r=>cc(r.chg)],vx:['Vol x',r=>f(r.volX,1)+'x'],
 oL:['Open−Low %',r=>f(r.oLp,2)],oH:['High−Open %',r=>f(r.oHp,2)],pos:['Day pos',r=>Math.round(r.pos*100)+'%']};
const TABS={gl:'Gainers / Losers',vol:'Volume Spurts',ol:'Open = Low',oh:'Open = High',orb:'Opening Range Breakout',pk:'Top Picks (score)',hist:'History'};
function render(){$('tabs').innerHTML=Object.entries(TABS).map(([k,v])=>`<button data-k="${k}" class="${k===S.tab?'on':''}">${v}</button>`).join('');
 const R=current(),n=+$('tn').value||10,v=$('view');
 const g=[...R].filter(r=>r.chg>0).sort((a,b)=>b.chg-a.chg).slice(0,n),l=[...R].filter(r=>r.chg<0).sort((a,b)=>a.chg-b.chg).slice(0,n);
 if(S.tab==='gl')v.innerHTML=`<div class="grid">${tbl(g,[C.sym,C.ltp,C.chg,C.vx],'▲ Top Gainers')}${tbl(l,[C.sym,C.ltp,C.chg,C.vx],'▼ Top Losers')}</div>
  <div class="card row"><span>Total <b>${R.length}</b></span><span class="u">Gainers <b>${R.filter(r=>r.chg>0).length}</b></span><span class="d">Losers <b>${R.filter(r=>r.chg<0).length}</b></span></div>`;
 else if(S.tab==='vol'){const x=R.filter(r=>r.volX>=+$('vx').value).sort((a,b)=>b.volX-a.volX);v.innerHTML=tbl(x,[C.sym,C.ltp,C.chg,C.vx,['Volume',r=>r.vol.toLocaleString('en-IN')]],'Volume Spurts (≥'+$('vx').value+'x avg)')}
 else if(S.tab==='ol'){const x=R.filter(r=>r.isOL).sort((a,b)=>b.chg-a.chg);v.innerHTML=tbl(x,[C.sym,C.ltp,C.chg,C.oL,C.vx],'Open = Low (tolerance '+$('tl').value+'%) — bullish bias')}
 else if(S.tab==='oh'){const x=R.filter(r=>r.isOH).sort((a,b)=>a.chg-b.chg);v.innerHTML=tbl(x,[C.sym,C.ltp,C.chg,C.oH,C.vx],'Open = High (tolerance '+$('tH').value+'%) — bearish bias')}
 else if(S.tab==='orb'){const D=lsG('d:'+$('day').value)||{},tm=555+ +$('orbm').value,mn=k=>+k.slice(0,2)*60+ +k.slice(3),ok=Object.keys(D).sort().filter(k=>mn(k)<=tm).pop(),M={};
  if(ok)D[ok].forEach(a=>M[a[0]]=[a[4],a[5]]);const B=[],W=[];
  R.forEach(r=>{const o=M[r.symbol];if(!o)return;if(r.ltp>o[0])B.push({...r,orh:o[0],orl:o[1],bp:(r.ltp-o[0])/o[0]*100});else if(r.ltp<o[1])W.push({...r,orh:o[0],orl:o[1],bp:(r.ltp-o[1])/o[1]*100})});
  B.sort((a,b)=>b.bp-a.bp);W.sort((a,b)=>a.bp-b.bp);const oc=[C.sym,C.ltp,['OR High',r=>f(r.orh)],['OR Low',r=>f(r.orl)],['Break %',r=>(r.bp>=0?'+':'')+f(r.bp),r=>cc(r.bp)],C.vx];
  v.innerHTML=(ok?'':'<div class="card mut">Opening range abhi ban rahi hai — pehla snapshot 9:15 ke baad aayega.</div>')+`<div class="grid">${tbl(B,oc,'▲ ORB Breakout (above OR High, '+$('orbm').value+'m range)')}${tbl(W,oc,'▼ ORB Breakdown (below OR Low)')}</div>`}
 else if(S.tab==='pk'){const x=[...R].sort((a,b)=>b.score-a.score).slice(0,n);v.innerHTML=tbl(x,[C.sym,C.ltp,C.chg,['Score',r=>`<div class="bar"><i style="width:${r.score}%"></i></div>${r.score}`],['Why',r=>`<small>${r.why||'–'}</small>`]],'Upside probability score (heuristic, not a guarantee)')}
 else{const ds=days();v.innerHTML=`<div class="card"><b>Saved days</b><table>${ds.map(d=>{const D=lsG('d:'+d)||{};return`<tr><td>${d}</td><td>${Object.keys(D).length} snapshots</td><td><button class="g" data-day="${d}">Open</button></td></tr>`}).join('')||'<tr><td>No data yet</td></tr>'}</table><p class="mut">Data browser (localStorage) me save hota hai. Long-term ke liye backend/DB se jodo.</p></div>`}}
document.addEventListener('click',e=>{const b=e.target;if(b.dataset.k){S.tab=b.dataset.k;render()}if(b.dataset.day){$('day').value=b.dataset.day;S.snap='hist';setSlider();S.tab='gl';render()}});
$('sl').oninput=()=>{S.snap='hist';const k=S.ks[$('sl').value];$('sv').textContent=k||'–';render()};
$('day').onchange=()=>{S.snap='hist';setSlider();render()};
$('live').onclick=()=>{S.snap='live';$('day').value=today();setSlider();render()};
['tl','tH','vx','tn'].forEach(i=>$(i).oninput=()=>{S.live=enrich(S.raw||[],today(),Object.values(lsG('d:'+today())||{}));render()});
$('rf').onclick=refresh;$('orbm').onchange=render;
$('ld').onclick=()=>{try{window.dmatxLoad(JSON.parse($('ta').value))}catch(e){status('Invalid JSON')}};
window.dmatxLoad=q=>{S.pasted=Array.isArray(q)?q:fromKite(q);$('src').value='paste';refresh()};
$('ex').onclick=()=>{const o={};days().forEach(d=>o[d]=lsG('d:'+d));$('ta').value=JSON.stringify(o);$('ta').select();try{navigator.clipboard.writeText($('ta').value)}catch(e){}};
$('th').onclick=()=>{const r=document.documentElement;r.dataset.theme=r.dataset.theme==='light'?'dark':'light'};
let T;function auto(){clearInterval(T);const m=+$('iv').value;if(m)T=setInterval(refresh,m*60000)}
$('iv').onchange=auto;$('src').onchange=refresh;
refresh();auto();
</script></body></html>
